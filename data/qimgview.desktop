[Desktop Entry]
Type=Application
Version=1.0
Name=QImgView
GenericName=Image Viewer
Comment=Browse, compare, and arrange images in Image, Gallery, and Workspace modes
Exec=qimgview %F
Icon=qimgview
Terminal=false
Categories=Graphics;Viewer;2DGraphics;RasterGraphics;
MimeType=image/jpeg;image/png;image/gif;image/bmp;image/webp;image/tiff;image/svg+xml;image/x-xpixmap;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-tga;image/avif;image/heic;image/heif;image/jxl;application/zip;application/x-7z-compressed;application/x-rar;application/x-rar-compressed;application/x-tar;application/gzip;application/x-bzip2;application/x-xz;
Keywords=picture;photo;jpeg;png;gallery;workspace;slideshow;archive;zip;
StartupNotify=true
StartupWMClass=qimgview
Homepage=https://github.com/Grumbel/qimgview
