<component type="desktop-application">
  <id>biltoo.desktop</id>
  <name>Biltoo</name>
  <summary>Classic image viewer with Gallery and free-form Workspace</summary>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="grumbel.github.io">
    <name>Ingo Ruhnke</name>
  </developer>
  <description>
    <p>
      Biltoo is a Qt 6 image viewer built around one canvas and three modes:
      classic single-image browsing, a session Gallery with packaged layouts,
      and a free-form Workspace for comparing and arranging multiple images.
    </p>
    <p>
      Open files, folders, or common archives (zip, tar, 7z, rar). Sessions can
      be sorted, navigated with a thumbnail strip, and saved as portable
      project files. Workspace supports transform handles, crop, colour
      adjustments, a print page guide, and PNG/PDF export without overwriting
      sources.
    </p>
    <p>
      Slideshow supports optional transitions (crossfade, fade through black,
      slide projector). Fullscreen hides chrome and restores it on exit.
    </p>
  </description>
  <url type="homepage">https://github.com/Grumbel/biltoo</url>
  <url type="bugtracker">https://github.com/Grumbel/biltoo/issues</url>
  <launchable type="desktop-id">biltoo.desktop</launchable>
  <provides>
    <binary>biltoo</binary>
  </provides>
  <categories>
    <category>Graphics</category>
    <category>Viewer</category>
    <category>2DGraphics</category>
    <category>RasterGraphics</category>
  </categories>
  <keywords>
